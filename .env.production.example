# ========================================================
# Hostinger & Production Environment Configuration
# ========================================================

# Application Mode & Port
NODE_ENV=production
PORT=5000

# MongoDB Database Connection
# Replace with your actual MongoDB Atlas cluster connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dimension_composition?retryWrites=true&w=majority

# JWT Authentication Secret Key (replace with any long random secret string)
JWT_SECRET=dimension_composition_super_secure_secret_key_2026

# Optional: Admin Setup Protection Key
# If set, creating additional admin accounts requires this key
ADMIN_SETUP_SECRET=dc_admin_secure_setup_key_2026

# Email Notifications (Optional - for sending email on contact form submission)
# If using Gmail, generate an App Password from Google Account Security:
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
NOTIFICATION_EMAIL=contact@dimensioncomposition.com
